@startuml c4-context
title RMU Engine Context Diagram

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' LAYOUT_LEFT_RIGHT()

UpdateElementStyle(person, $bgColor="#2b4a74ff")
UpdateElementStyle(system, $bgColor="#4373b1ff")
UpdateElementStyle(external_system, $bgColor="#96b6beff")
UpdateElementStyle(boundary, $bgColor="#d1dcdfff")

Person(user, "User")

System(gateway, "Gateway", "Caddy: single origin http://localhost")

Boundary(frontend, "RMU Engine Microfrontends") {
    System(rmu_mfe_shell, "MFE Shell", "React host")
    System(rmu_mfe_core, "MFE Core", "React")
    System(rmu_mfe_strategic, "MFE Strategic", "React")
    System(rmu_mfe_tactical, "MFE Tactical", "React")
    System(rmu_mfe_items, "MFE Items", "React")
    System(rmu_mfe_npc, "MFE NPCs", "React")
    System(rmu_mfe_spells, "MFE Spells", "React")
    System(rmu_react_shared_lib, "React Shared Lib", "React + MUI, API clients")
    System(rmu_mfe_assets, "MFE Assets", "Static files: locales, images...")
}

Boundary(apis, "RMU Engine APIs") {
    System(rmu_api_users, "Users API", "NestJS")
    System(rmu_api_core, "Core API", "NestJS")
    System(rmu_api_strategic, "Strategic API", "NestJS")
    System(rmu_api_tactical, "Tactical API", "NestJS")
    System(rmu_api_npc, "NPCs API", "NestJS")
    System(rmu_api_npc_names, "NPC Names API", "Node.js")
    System(rmu_api_spells, "Spells API", "NestJS")
    System(rmu_api_items, "Items API", "NestJS")
    System(rmu_api_attack_tables, "Attack Tables API", "NestJS, tables as files")
    System(rmu_api_media, "Media API", "NestJS")
}

Boundary(infrastructure, "Infrastructure") {
    System_Ext(mongodb, "MongoDB", "8.x, one database per API")
    System_Ext(keycloak, "Keycloak", "26.x")
    System_Ext(kafka, "Kafka", "3.4.x")
    System_Ext(postgresql, "PostgreSQL", "16.x")
}

Boundary(aws, "AWS") {
    System_Ext(s3, "S3", "User uploads (locally rmu-s3, SeaweedFS)")
}

' Browser entry: everything goes through the gateway (/, /mfe/<name>/, /api/<name>/, /sso/, /media/).
Rel(user, gateway, "Navigate", "HTTP")
Rel(gateway, rmu_mfe_shell, "Serves the shell and the remotes", "HTTP")

' Frontend composition. Every MFE uses the shared lib, whose components also call other APIs
' (pickers, rule tables...); only the main API of each MFE is drawn.
Rel(rmu_mfe_shell, rmu_mfe_core, "Federation", "Webpack")
Rel(rmu_mfe_shell, rmu_mfe_strategic, "Federation", "Webpack")
Rel(rmu_mfe_shell, rmu_mfe_tactical, "Federation", "Webpack")
Rel(rmu_mfe_shell, rmu_mfe_items, "Federation", "Webpack")
Rel(rmu_mfe_shell, rmu_mfe_npc, "Federation", "Webpack")
Rel(rmu_mfe_shell, rmu_mfe_spells, "Federation", "Webpack")
Rel(rmu_mfe_shell, rmu_react_shared_lib, "Uses", "link: dependency")

Rel(rmu_mfe_shell, keycloak, "Authenticate user", "OIDC, PKCE")
Rel(rmu_mfe_shell, rmu_mfe_assets, "Load images and locales", "HTTP")
Rel(rmu_mfe_shell, rmu_api_users, "Profile, friends, admin", "HTTP")
Rel(rmu_mfe_shell, rmu_api_media, "Upload images", "HTTP")
Rel(rmu_mfe_shell, s3, "Load uploads (/media/)", "HTTP")

Rel(rmu_mfe_core, rmu_api_core, "", "HTTP")
Rel(rmu_mfe_strategic, rmu_api_strategic, "", "HTTP")
Rel(rmu_mfe_strategic, rmu_api_npc_names, "Random names", "HTTP")
Rel(rmu_mfe_tactical, rmu_api_tactical, "", "HTTP")
Rel(rmu_mfe_items, rmu_api_items, "", "HTTP")
Rel(rmu_mfe_npc, rmu_api_npc, "", "HTTP")
Rel(rmu_mfe_spells, rmu_api_spells, "", "HTTP")

' Calls between APIs (RMU_API_<NAME>_URI).
Rel(rmu_api_core, rmu_api_users, "Check friendships to share realms", "HTTP")
Rel(rmu_api_items, rmu_api_core, "Realm access (spec 073)", "HTTP")
Rel(rmu_api_npc, rmu_api_core, "Realm access (spec 073)", "HTTP")
Rel(rmu_api_spells, rmu_api_core, "Effect types", "HTTP")
Rel(rmu_api_strategic, rmu_api_core, "Realms, races, skills, rules", "HTTP")
Rel(rmu_api_strategic, rmu_api_items, "Items, trading and treasure tables, materials", "HTTP")
Rel(rmu_api_strategic, rmu_api_spells, "Spell lists, alchemy tables", "HTTP")
Rel(rmu_api_strategic, rmu_api_npc, "NPCs of the factions", "HTTP")
Rel(rmu_api_strategic, rmu_api_users, "Friendships to add game members", "HTTP")
Rel(rmu_api_tactical, rmu_api_core, "Rules and catalogs", "HTTP")
Rel(rmu_api_tactical, rmu_api_strategic, "Games, factions, characters", "HTTP")
Rel(rmu_api_tactical, rmu_api_items, "Items", "HTTP")
Rel(rmu_api_tactical, rmu_api_npc, "NPCs", "HTTP")
Rel(rmu_api_tactical, rmu_api_attack_tables, "Attack, critical and fumble tables", "HTTP")

Rel(rmu_api_users, keycloak, "Read/write users and groups", "Admin API")
Rel(rmu_api_media, s3, "Store uploads", "S3 API")
Rel(rmu_api_media, rmu_mfe_assets, "Read the base image manifest", "HTTP")

' Domain events (internal.<service>.<entity>.<event>.v1).
Rel(rmu_api_users, kafka, "Publishes user and friendship events", "Kafka")
Rel(rmu_api_core, kafka, "Publishes realm and race events; consumes user, friendship and strategic game events", "Kafka")
Rel(rmu_api_strategic, kafka, "Publishes game, faction and character events; consumes user, realm and race events", "Kafka")
Rel(rmu_api_tactical, kafka, "Publishes action events; consumes strategic game and faction events", "Kafka")
Rel(rmu_api_items, kafka, "Consumes realm deletions", "Kafka")
Rel(rmu_api_npc, kafka, "Consumes realm deletions", "Kafka")

Rel(keycloak, postgresql, "", "")

SHOW_LEGEND()

@enduml
