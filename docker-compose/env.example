MONGO_BASE_URI=mongodb://admin:admin@rmu-mongo:27017
MONGO_USER=admin
MONGO_PASSWORD=admin

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB_KEYCLOAK=keycloak

KAFKA_BROKERS=rmu-kafka-broker:9092

# Keycloak for microservices
KEYCLOAK_BASE_URI=http://rmu-keycloak:8080
KEYCLOAK_REALM=rmu
KEYCLOAK_CLIENT_ID=rmu-client
