KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL_HOST=rmu-postgres
KC_HOSTNAME=localhost
KC_LOG_LEVEL=INFO

KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=admin

AWS_S3_REGION=eu-west-1
