# rmu-platform: configuration of the production stack (workspace spec 103). Copy it to .env.production on
# the server and fill every <...>. The real file never goes into git: keep a copy in a password manager.
#
# It is read with the production override: make prod-config / make prod-up (docker compose
# --env-file .env.production -f compose.yaml -f compose/production.yaml). Same names as .env.example;
# see docs/architecture/configuration.adoc and docs/operations/production.adoc.
#
# Generate each secret with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
#   (letters and digits only, so it is safe inside the Mongo URIs and the shell)

# === Compose ====================================================================================
# No `tools` (Kafka UI) or `observability` (local Grafana); `dev` (Mailpit) stays off.
COMPOSE_PROFILES=infrastructure,apis,mfes,gateway,monitoring

# === Public host ================================================================================
# The name in DNS (A/AAAA to the server). Caddy issues its certificate from Let's Encrypt.
RMU_PUBLIC_HOST=rmu.labcabrera.com
# Account of the certificates: Let's Encrypt writes here about expiring certificates.
RMU_ACME_EMAIL=<email for Let's Encrypt>
# Empty in production. `local_certs` only to test this configuration on a workstation.
RMU_CADDY_TLS_OPTION=

# === Infrastructure =============================================================================
MONGO_USER=rmu
MONGO_PASSWORD=<secret>
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=<secret>
POSTGRES_DB_KEYCLOAK=keycloak
# Bootstrap admin of the master realm (admin console through the SSH tunnel, Terraform).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<secret>
KC_HOSTNAME=https://rmu.labcabrera.com/sso
# Kafka UI (profile tools) does not run in production; empty so compose does not warn.
KAFKA_UI_USER=
KAFKA_UI_PASSWORD=

# === APIs: shared settings ======================================================================
RMU_IAM_BASE_URI=http://rmu-keycloak:8080/sso
RMU_IAM_REALM=rmu
RMU_IAM_ISSUER_URI=https://rmu.labcabrera.com/sso/realms/rmu
RMU_IAM_AUDIENCE=rmu-api
RMU_IAM_CLIENT_ID=rmu-client
# Must match rmu_client_secret in terraform/stacks/keycloak-production/terraform.tfvars.
RMU_IAM_CLIENT_SECRET=<secret>
RMU_KAFKA_BROKERS=rmu-kafka-broker:9092
LOG_LEVEL=info

# === APIs: rmu-api-media (S3 in rmu-s3) =========================================================
RMU_MEDIA_S3_REGION=eu-west-1
RMU_MEDIA_S3_BUCKET=rmu-media
RMU_MEDIA_S3_ACCESS_KEY_ID=<secret>
RMU_MEDIA_S3_SECRET_ACCESS_KEY=<secret>

# === APIs: rmu-api-attack-tables ================================================================
# Folder on the server with the enriched tables (copied with rsync, never in an image), relative to
# compose/. Unset: the tables bundled in the image.
# RMU_ATTACK_TABLES_DATA_DIR=/opt/rmu/data/core-law

# === MFEs: public values for the browser ========================================================
RMU_MFE_IAM_URI=https://rmu.labcabrera.com/sso
RMU_MFE_IAM_CLIENT_ID=rmu-client-front
RMU_MFE_ASSETS_URI=/mfe/assets/
# RMU_SHELL_CONTACT_URI=
# RMU_SHELL_CONTACT_EMAIL=
# The operation tools of /admin/tools stay hidden: Kafka UI and the local Grafana do not run in
# production, and the Keycloak console is only reachable through the SSH tunnel.
RMU_ADMIN_KEYCLOAK_URI=
RMU_ADMIN_KAFKA_UI_URI=
# The Grafana Cloud stack, so /admin/tools links to it.
RMU_ADMIN_GRAFANA_URI=https://<stack>.grafana.net

# === Monitoring: Grafana Cloud (spec 103, D9) ===================================================
# From the Grafana Cloud portal: the stack's Prometheus and Loki "Details" pages give the URLs and the
# numeric users. One access policy token with metrics:write and logs:write serves both.
RMU_GRAFANA_CLOUD_PROMETHEUS_URI=https://prometheus-<region>.grafana.net/api/prom/push
RMU_GRAFANA_CLOUD_PROMETHEUS_USER=<number>
RMU_GRAFANA_CLOUD_LOKI_URI=https://logs-<region>.grafana.net/loki/api/v1/push
RMU_GRAFANA_CLOUD_LOKI_USER=<number>
RMU_GRAFANA_CLOUD_TOKEN=<secret>

# === Backups: restic to Cloudflare R2 (spec 103, D12) ===========================================
# Bucket and API token (Object Read & Write, that bucket only) created in the Cloudflare dashboard.
# Keep RMU_BACKUP_RESTIC_PASSWORD in the password manager too: without it the backups cannot be read.
RMU_BACKUP_RESTIC_REPOSITORY=s3:https://<account id>.r2.cloudflarestorage.com/<bucket>
RMU_BACKUP_RESTIC_PASSWORD=<secret>
RMU_BACKUP_S3_ACCESS_KEY_ID=<secret>
RMU_BACKUP_S3_SECRET_ACCESS_KEY=<secret>

# === House rules ================================================================================
RMU_STRATEGIC_JEWELER_PERCENT=3

# === Image versions =============================================================================
# Always explicit versions published on Docker Hub: never latest or local (spec 103, D3).
RMU_API_CORE_VERSION=<version>
RMU_API_STRATEGIC_VERSION=<version>
RMU_API_TACTICAL_VERSION=<version>
RMU_API_ATTACK_TABLES_VERSION=<version>
RMU_API_ITEMS_VERSION=<version>
RMU_API_NPC_NAMES_VERSION=<version>
RMU_API_NPCS_VERSION=<version>
RMU_API_SPELLS_VERSION=<version>
RMU_API_USERS_VERSION=<version>
RMU_API_MEDIA_VERSION=<version>
RMU_MFE_SHELL_VERSION=<version>
RMU_MFE_CORE_VERSION=<version>
RMU_MFE_STRATEGIC_VERSION=<version>
RMU_MFE_TACTICAL_VERSION=<version>
RMU_MFE_NPCS_VERSION=<version>
RMU_MFE_ITEMS_VERSION=<version>
RMU_MFE_SPELLS_VERSION=<version>
RMU_MFE_WIKI_VERSION=<version>
RMU_MFE_ASSETS_VERSION=<version>
