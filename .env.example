# Compose profiles to start with `docker compose up -d` (comma-separated).
# Available profiles (see docs/local-development.adoc):
#   infrastructure  MongoDB, PostgreSQL, Keycloak and Kafka
#   apis            Backend API containers
#   mfes            React micro-frontends (no services defined yet)
#   tools           Development tools: Kafka UI, Mongo Express
#   gateway         nginx gateway on port 80 with the ALB path routing
#   observability   Grafana + OTel collector (grafana/otel-lgtm)
# apis and tools must be combined with infrastructure, otherwise compose fails
# with "depends on undefined service".
# Examples:
#   COMPOSE_PROFILES=infrastructure                    only infra, run APIs from source
#   COMPOSE_PROFILES=infrastructure,tools              infra + Kafka UI + Mongo Express
#   COMPOSE_PROFILES=infrastructure,apis,mfes,tools    full stack (default)
# --profile on the CLI replaces this value: docker compose --profile infrastructure up -d
COMPOSE_PROFILES=infrastructure,apis,mfes,tools

MONGO_BASE_URI=mongodb://admin:admin@rmu-mongo:27017
MONGO_USER=admin
MONGO_PASSWORD=admin

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB_KEYCLOAK=keycloak

KAFKA_BROKERS=rmu-kafka-broker:9092

# Keycloak for microservices
KEYCLOAK_BASE_URI=http://rmu-keycloak:8080
KEYCLOAK_REALM=rmu
KEYCLOAK_CLIENT_ID=rmu-client
KEYCLOAK_CLIENT_SECRET=changeit

# Keycloak for instance
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_DB_URL_HOST=rmu-postgres
KC_HOSTNAME=localhost
KC_LOG_LEVEL=INFO

# Tools profile
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=admin
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

AWS_S3_REGION=eu-west-1
AWS_S3_BUCKET=rmu-static-assets-pro
AWS_S3_BASE_FOLDER=rmu-mfe-assets
AWS_S3_IMAGE_FOLDER=images
AWS_ACCESS_KEY_ID={foo}
AWS_SECRET_ACCESS_KEY={bar}

MEDIA_ASSETS_URI=https://assets.labcabrera.com/

LOG_LEVEL=debug

# Gateway profile: host port of the nginx gateway
RMU_GATEWAY_PORT=80

# Image versions. Pin explicit versions for anything other than local development.
RMU_API_CORE_VERSION=latest
RMU_API_STRATEGIC_VERSION=latest
RMU_API_TACTICAL_VERSION=latest
RMU_API_ATTACK_VERSION=latest
RMU_API_ATTACK_TABLES_VERSION=latest
RMU_API_ITEMS_VERSION=latest
RMU_API_NPC_NAMES_VERSION=latest
RMU_API_NPCS_VERSION=latest
RMU_API_SPELLS_VERSION=latest
RMU_API_USERS_VERSION=latest
RMU_API_MEDIA_VERSION=latest
OTEL_LGTM_VERSION=latest
