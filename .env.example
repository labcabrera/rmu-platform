# rmu-platform: configuration of the local Compose stack. Copy to .env (`cp .env.example .env`).
#
# Naming (docs/architecture/configuration.adoc):
#   RMU_*        values shared by the RMU services (APIs, MFEs, gateway). When a value is passed
#                as is, it keeps the name the service reads (RMU_IAM_CLIENT_ID, RMU_KAFKA_BROKERS...).
#   RMU_MFE_*    public values for the browser (rendered into each MFE's env-config.js).
#   MONGO_*, POSTGRES_*, KC_*, KAFKA_UI_*, MONGO_EXPRESS_*   third-party images, with their own names.

# === Compose ====================================================================================
# Profiles started by `docker compose up -d` / `make up` (comma-separated):
#   infrastructure  MongoDB, PostgreSQL, Keycloak, Kafka
#   apis            backend API containers (needs infrastructure)
#   mfes            micro-frontends as static images (shell, core, strategic, tactical, npcs, items, spells, assets)
#   gateway         Caddy on port 80: shell at /, MFEs at /mfe/<name>/, APIs at /api/<name>/
#   tools           Kafka UI, Mongo Express (needs infrastructure)
#   observability   Grafana + OTel collector (grafana/otel-lgtm)
# Examples:
#   COMPOSE_PROFILES=infrastructure                              only infra, run APIs from source
#   COMPOSE_PROFILES=infrastructure,tools                        infra + Kafka UI + Mongo Express
#   COMPOSE_PROFILES=infrastructure,apis,mfes,gateway,tools      full stack (default)
# --profile on the CLI replaces this value: docker compose --profile infrastructure up -d
COMPOSE_PROFILES=infrastructure,apis,mfes,gateway,tools

# === Infrastructure =============================================================================
# MongoDB root user. The APIs connect with it (mongodb://MONGO_USER:MONGO_PASSWORD@rmu-mongo:27017),
# and so do scripts/mongo-backup.sh and scripts/mongo-restore.sh.
MONGO_USER=admin
MONGO_PASSWORD=admin

# PostgreSQL, storage of Keycloak.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB_KEYCLOAK=keycloak

# Keycloak server: bootstrap admin and public URL. Keycloak is served under /sso, through the
# gateway (http://localhost/sso) and on :8090/sso for the admin console and Terraform.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_HOSTNAME=http://localhost/sso

# Mailpit: SMTP for Keycloak (password reset, email verification). Web UI on this port.
MAILPIT_UI_PORT=8025

# === Tools ======================================================================================
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=admin
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# === Gateway ====================================================================================
# Host port of the Caddy gateway (http://localhost).
RMU_GATEWAY_PORT=80

# === APIs: shared settings (in-network addresses) ===============================================
# Keycloak as seen from the containers, and the confidential client used by the APIs.
# RMU_IAM_CLIENT_SECRET must match rmu_client_secret in terraform/stacks/keycloak-local/terraform.tfvars.
# The issuer is the public URL (KC_HOSTNAME); every API checks it, and the audience, on each token.
RMU_IAM_BASE_URI=http://rmu-keycloak:8080/sso
RMU_IAM_REALM=rmu
RMU_IAM_ISSUER_URI=http://localhost/sso/realms/rmu
RMU_IAM_AUDIENCE=rmu-api
RMU_IAM_CLIENT_ID=rmu-client
RMU_IAM_CLIENT_SECRET=changeit
RMU_KAFKA_BROKERS=rmu-kafka-broker:9092
LOG_LEVEL=debug

# === APIs: rmu-api-media (S3) ===================================================================
# RMU_MEDIA_S3_BASE_FOLDER is the root of rmu-mfe-assets in the bucket: image URLs are paths
# relative to it (images/<category>/<file>), resolved by the MFEs against RMU_MFE_ASSETS_URI.
RMU_MEDIA_S3_REGION=eu-west-1
RMU_MEDIA_S3_BUCKET=rmu-static-assets-pro
RMU_MEDIA_S3_BASE_FOLDER=rmu-mfe-assets
RMU_MEDIA_S3_IMAGE_FOLDER=images
RMU_MEDIA_S3_ACCESS_KEY_ID={foo}
RMU_MEDIA_S3_SECRET_ACCESS_KEY={bar}

# === MFEs: public values for the browser ========================================================
# Rendered into each MFE image's env-config.js, so they must be reachable from the host (not
# rmu-* container names). Remote and API URLs are fixed gateway paths (compose/mfes.yaml).
RMU_MFE_IAM_URI=http://localhost/sso
RMU_MFE_IAM_CLIENT_ID=rmu-client-front
RMU_MFE_ASSETS_URI=/mfe/assets/
# Base URL of the i18n locales. Defaults to RMU_MFE_ASSETS_URI.
# RMU_MFE_I18N_URI=
# Contact page of the shell (optional).
# RMU_SHELL_CONTACT_URI=
# RMU_SHELL_CONTACT_EMAIL=

# === Image versions =============================================================================
# Pin explicit versions for anything other than local development. `local` is the tag built by
# `make docker-build` in each rmu-mfe-* repository.
RMU_API_CORE_VERSION=latest
RMU_API_STRATEGIC_VERSION=latest
RMU_API_TACTICAL_VERSION=latest
RMU_API_ATTACK_TABLES_VERSION=latest
RMU_API_ITEMS_VERSION=latest
RMU_API_NPC_NAMES_VERSION=latest
RMU_API_NPCS_VERSION=latest
RMU_API_SPELLS_VERSION=latest
RMU_API_USERS_VERSION=latest
RMU_API_MEDIA_VERSION=latest
# No MFE has a published nginx image yet (rmu-mfe-shell:latest is the old dev-server image):
# build each one with `make docker-build` in its repository, which tags it `local`.
RMU_MFE_SHELL_VERSION=local
RMU_MFE_CORE_VERSION=local
RMU_MFE_STRATEGIC_VERSION=local
RMU_MFE_TACTICAL_VERSION=local
RMU_MFE_NPCS_VERSION=local
RMU_MFE_ITEMS_VERSION=local
RMU_MFE_SPELLS_VERSION=local
RMU_MFE_ASSETS_VERSION=local
# CADDY_VERSION=2.10-alpine
OTEL_LGTM_VERSION=latest
