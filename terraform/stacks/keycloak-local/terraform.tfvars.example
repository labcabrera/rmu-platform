# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
keycloak_url            = "http://localhost:8090"
keycloak_base_path      = "/sso"
keycloak_admin_username = "admin"
keycloak_admin_password = "admin"

realm_name         = "rmu"
realm_display_name = "Rolemaster Unified Engine"

rmu_client_secret = "changeit"

# The gateway (http://localhost) and the shell dev server. To open the SPA from another machine on
# the LAN, add its address here and in rmu_client_front_web_origins, e.g. "http://192.168.1.10/*".
rmu_client_valid_redirect_uris       = ["http://localhost/*", "http://localhost:8080/*"]
rmu_client_web_origins               = ["http://localhost", "http://localhost:8080"]
rmu_client_front_valid_redirect_uris = ["http://localhost/*", "http://localhost:8080/*"]
rmu_client_front_web_origins         = ["http://localhost", "http://localhost:8080"]

# ---------------------------------------------------------------------------
# Google login (placeholders until the application is installed; see
# docs/operations/keycloak-terraform.adoc). Redirect URI to register in Google:
# http://localhost/sso/realms/rmu/broker/google/endpoint
# ---------------------------------------------------------------------------
google_client_id     = "placeholder-google-client-id"
google_client_secret = "placeholder-google-client-secret"

# ---------------------------------------------------------------------------
# SMTP (Mailpit container of the infrastructure profile; "" disables mail)
# ---------------------------------------------------------------------------
smtp_host = "rmu-mailpit"
smtp_port = "1025"
smtp_from = "no-reply@rmu.local"

# ---------------------------------------------------------------------------
# Users
# ---------------------------------------------------------------------------
primary_user_username   = "luiscabrera"
primary_user_email      = "lab.cabrera@gmail.com"
primary_user_first_name = "Luis"
primary_user_last_name  = "Cabrera"
primary_user_password   = "changeit"

guest_user_username   = "genericuser"
guest_user_email      = "generic-user@example.com"
guest_user_first_name = "John"
guest_user_last_name  = "Doe"
guest_user_password   = "changeit"
